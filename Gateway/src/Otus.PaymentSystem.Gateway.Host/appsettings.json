{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "otus-payment-system",
    "Audience": "otus-payment-system-clients"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-me": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/auth/me"
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathPattern": "/auth/me"
          }
        ]
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/users/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathPattern": "/users/{**catch-all}"
          }
        ]
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5100/"
          }
        }
      }
    }
  }
}
