<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!--
      VSTest testhost по умолчанию открывает handle родительского процесса.
      В restricted/EDR-окружениях это даёт Win32Exception(5) Access denied.
      Тестам parent-process query не нужен.
    -->
    <_MSTestEnableParentProcessQuery>false</_MSTestEnableParentProcessQuery>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>



  <ItemGroup>
    <ProjectReference Include="..\..\src\Otus.PaymentSystem.Gateway.Host\Otus.PaymentSystem.Gateway.Host.csproj" />
  </ItemGroup>

</Project>
