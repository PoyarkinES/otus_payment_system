{
  "openapi": "3.0.1",
  "info": {
    "title": "Otus Payment System — Gateway/BFF API",
    "description": "Единая точка входа для клиента: BFF-агрегаты /bff/* и проксирование /api/identity/**.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Gateway (edge)"
    }
  ],
  "paths": {
    "/bff/me": {
      "get": {
        "tags": [
          "BFF"
        ],
        "operationId": "BffMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BffMeResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/bff/health": {
      "get": {
        "tags": [
          "BFF"
        ],
        "operationId": "BffHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BffHealthResult"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BffHealthResult"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/bff/wallets": {
      "get": {
        "tags": [
          "BFF"
        ],
        "summary": "Сводка по кошелькам пользователя",
        "description": "Возвращает кошельки, суммы по валютам и последние операции. recentOperations по умолчанию равен 5; допустимый диапазон — 0..20.",
        "operationId": "BffWallets",
        "parameters": [
          {
            "name": "recentOperations",
            "in": "query",
            "schema": {
              "maximum": 20,
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BffWalletsResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Otus.PaymentSystem.Gateway.Host"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BffHealthResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          },
          "services": {
            "$ref": "#/components/schemas/BffServiceStatus"
          }
        },
        "additionalProperties": false
      },
      "BffMeResult": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BffServiceStatus": {
        "type": "object",
        "properties": {
          "gateway": {
            "type": "string",
            "nullable": true
          },
          "identity": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BffWalletCurrencyTotalResult": {
        "type": "object",
        "required": [
          "currency",
          "available",
          "held",
          "total"
        ],
        "properties": {
          "currency": {
            "type": "string"
          },
          "available": {
            "type": "number",
            "format": "double"
          },
          "held": {
            "type": "number",
            "format": "double"
          },
          "total": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "BffWalletOperationResult": {
        "type": "object",
        "required": [
          "id",
          "referenceId",
          "type",
          "amount",
          "currency",
          "balanceBefore",
          "balanceAfter",
          "description",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "referenceId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "type": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "balanceBefore": {
            "type": "number",
            "format": "double"
          },
          "balanceAfter": {
            "type": "number",
            "format": "double"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "BffWalletResult": {
        "type": "object",
        "required": [
          "id",
          "currency",
          "available",
          "held",
          "total",
          "status",
          "recentOperations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string"
          },
          "available": {
            "type": "number",
            "format": "double"
          },
          "held": {
            "type": "number",
            "format": "double"
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string"
          },
          "recentOperations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BffWalletOperationResult"
            }
          }
        },
        "additionalProperties": false
      },
      "BffWalletsResult": {
        "type": "object",
        "required": [
          "wallets",
          "totals"
        ],
        "properties": {
          "wallets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BffWalletResult"
            }
          },
          "totals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BffWalletCurrencyTotalResult"
            }
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT access token: Authorization: Bearer {token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}